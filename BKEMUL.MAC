	MOV	#KPOWTG,BKPOWT

KFK:	RTS	PC


;    ---------------------------------------------
;    ** 0.8. ςεδαλτιςοχαξιε σινχομψξοηο λυςσοςα **
;    ---------------------------------------------

PREDSK:	JSR	PC,PSTSK
	CLR	R5
	JSR	PC,PFASIM
	JSR	PC,PFSK

	RTS	PC


;    ------------------------
;    ** 0.9. σβςοσ σινχομα **
