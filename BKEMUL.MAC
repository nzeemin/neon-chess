;NOTE: ξΑΝ ΞΕ ΞΥΦΞΟ ΠΟΛΑΪΩΧΑΤΨ ΙΞΔΙΛΑΤΟÒ ÒΕΦΙΝΑ
;PFINDR:
	;RTS	PC


;    --------------------------------------------
;    ** 0.6. ζοςνιςοχαξιε ιξδιλατοςα ταβυμργιι **
;    --------------------------------------------

PFINDT:	MOV	FONSS,R1	;  σβςοσ ιξδιλατοςα
	MOV	BAZVP,R3
	ADD	ANVP,R3
	MOV	#3,R4
10$:	JSR	PC,PZTVSW
	SOB	R4,10$

	MOV	#20,R4		;  υστ. δμιξω σμοχα
	TSTB	PRCW
	BEQ	1$
	ASL	R4

1$:	CLR	R5		;  ποισλ ποϊιγιι ταβυμργιι
7$:	CLR	R2
	MOV	MTAB(R5),R0
4$:	ROR	R0
	BCS	2$
	BEQ	3$
6$:	INC	R2
	BR	4$

2$:	MOV	R2,R1		;  υσταξοχλα ιξδιλατοςα
	TSTB	PRCW
	BNE	5$
	ADD	R3,R1
	MOVB	MCWSS,(R1)
	BR	6$
5$:	ASL	R1
	ADD	R3,R1
	MOV	MCWSS,(R1)
	BR	6$

3$:	ADD	#2,R5		;  ιϊνεξεξιε αδςεσοχ
	ADD	R4,R3
	BIT	#77,R3
	BNE	7$
	SUB	#100,R3

	RTS	PC


;    -------------------------------
;    ** 0.7. ζοςνιςοχαξιε λυςσοςα **
