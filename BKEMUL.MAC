PSREG0:
	;MOV	#220,@#ASPORT	;- σβςοσ ητ. τμη.

PSREG:	MOV	R3,-(SP)
	MOV	R2,-(SP)
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	MOV	R4,-(SP)
	RTS	R4

;    -----------------------------------
;    ** 0.2. χοσσταξοχμεξιε ςεηιστςοχ **
;    -----------------------------------

PWREG:	MOV	(SP)+,R0
	MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	(SP)+,R2
	MOV	(SP)+,R3
	RTS	R4


;    ----------------
;    ** 0.3. σβςοσ **
;    ----------------

PSBR:	JSR	PC,PFINDT	;  υστ.ιξδ.ταβ.

