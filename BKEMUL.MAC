;   =======================
;   *** λοξσταξτω DKLAW ***
;   =======================

	;AWPKL1	= 60		;- αδςεσ χελτοςα πς. λμαχ.1
	;AWPKL2	= 274		;- αδςεσ χελτοςα πς. λμαχ.2
	;ARSKL	= 177660	;- αδςεσ ςεη.σοστορξιρ λμαχ.
	;ARDKL	= 177662	;- αδςεσ ςεη.δαξξωθ λμαχ.

	;ASPORT	= 177716	;- αδςεσ σιστενξοηο ποςτα
	;APRWK	= 262		;- αδςεσ πςιϊξαλα χλ
	KPOWTS	= 20000		;- λοξσταξτα ποχτοςα σινχομα
	KPOWTG	= 4000		;- λοξσταξτα ποχτοςα ητ


PSIGN:	RETURN	;STUB


;  ************************************************
;  *                                              *
;  *    δ ς α κ χ ε ς    T V - ν ο ξ ι τ ο ς α    *
;  *                                              *
;  ************************************************

;   =======================
;   *** λοξσταξτω DTVMN ***
;   =======================

	ARRUL	= 177664	;- αδςεσ ςεηιστςα ςυμοξα
	NZRUL0	= 1330		;- ξαώ. ϊξαώεξιε RRUL χ οσξ.ςεφ.
	NZRUL1	= 230		;- ξαώ. ϊξαώεξιε RRUL χ ςεφ. ςπ

	KSSTR	= 100		;- λομιώ. σινχομοχ χ στςολε
	KTVSS	= 12		;- λομιώ. TV στςολ χ σινχ. στςολε
	KTVSSS	= 20		;- λομιώ. TV στςολ χ σμυφ. στςολε

	DTVSTB	= 100		;- δμιξα TV στςολι
	DTVSTS	= 40
	DSSTRB	= 1200		;- δμιξα σινχομψξοκ στςολι
	DSSTRS	= 500
	DSLSTB	= 2000		;- δμιξα σμυφεβξοκ στςολι
	DSLSTS	= 1000


; ========================================
; ***** νοδυμψ ζοςνιςοχαξιρ σινχομοχ *****
; ========================================


MFSIM:	;χθοδ:	R0 - λοδ χ νμ. βακτε

;   =================================
;   *** 1. βμολ υπςαχμεξιρ MFSTVM ***
;   =================================


BUMFS:	JSR	R4,PSREG	;  σοθςαξεξιε ςεηιστςοχ
	INC	SCKOD		;- σώετ λοδοχ

	TSTB	PRGRAF		;  τελστοχαρ ηςαζιλα
	BEQ	1$
	JSR	PC,BTG
	BR	KBUMFS

1$:	BIC	#177400,R0	;  ηςαζιώεσλιε σινχομω
	CMPB	R0,#177
	BHI	2$
	CMPB	R0,#37
	BLOS	3$
	SUB	#20,R0
5$:	JSR	PC,BGS
	BR	KBUMFS
2$:	CMPB	R0,#237
	BLOS	4$
	SUB	#60,R0
	BR	5$

3$:	CMPB	R0,#21		;  ςεδαλτιςυΰύιε σινχομω
	BLOS	6$
7$:	JSR	PC,BRS
	BR	KBUMFS

6$:	CMPB	R0,#10		;  υπςαχμρΰύιε σινχομω
	BEQ	7$
	JSR	PC,BUS
	BR	KBUMFS

4$:	JSR	PC,BFS		;  ζυξλγιοξαμψξωε σινχομω

KBUMFS:	JSR	R4,PWREG
	RTS	PC


;   ====================================
;   *** 2. βμολ ηςαζιώεσλιθ σινχομοχ ***
;   ====================================


BGS:	JSR	PC,PFSIM	;  ζοςνιςοχαξιε σινχομα

	ADD	DSIMB,NOMSIM	;  ιϊνεξεξιε αδςεσα σινχομα
	JSR	PC,PFASIM

	JSR	PC,PFSK		;  ζοςνιςοχαξιε λυςσοςα

	RTS	PC


;    --------------------------------------
;    ** 2.1. ζοςνιςοχαξιε αδςεσα σινχομα **
;    --------------------------------------

PFASIM:	TSTB	R5		;  πςιϊξαλ πςοιϊχ. αδςεσα
	BEQ	1$

	BIT	#77,NOMSIM	;  πςοχεςλα ξαώαμα στςολι
	BNE	2$

1$:	TSTB	PRNRUL		;  χοσστ. σμυφ. στςολι
	BEQ	8$
	;JSR	PC,PFSSTR
	CLRB	PRNRUL

8$:	CLR	R3		;  οπςεδ. ξαπςαχμ. δχιφ. λυςσ.
	MOV	NOMSIM,R5
	BPL	3$
	TST	(R3)+		;- χχεςθ
6$:	ADD	#KSSTR,R5
	BMI	6$
	BR	4$
3$:	CMP	R5,KSVP		;- χξιϊ
	BLO	5$
7$:	SUB	#KSSTR,R5
	CMP	R5,KSVP
	BHIS	7$

4$:	JSR	PC,PRUL		;  οτςαβοτλα ςυμοξα

5$:	MOV	R5,NOMSIM	;  χωώισμεξιε AS
	MOV	R5,R4
	BIC	#177700,R4
	BIC	#77,R5
	ASL	R5
	ADD	R5,R4
	ASL	R5
	ASL	R5
	ADD	R5,R4
	ADD	BAZVP,R4
	BIC	#140000,R4
	ADD	ANVP,R4
	MOV	R4,AS
	BR	KFASIM

2$:	ADD	DSIMB,AS	;  χωώισμεξιε AS χ στςολε

KFASIM:	RTS	PC


;    -----------------------------
;    ** 2.1.1. οτςαβοτλα ςυμοξα **
;    -----------------------------

PRUL:	TSTB	PRRP		;  πςιϊξαλ ςασϋιςεξξοκ πανρτι
	BNE	1$

	MOV	KRUL1(R3),R4	;  σδχιη σμυφ. στςολι
	MOV	BAZVP,R1
	MOV	#KTVSSS,R2
	MOV	#DSSTRB,-(SP)
	TST	R3
	BEQ	2$
	SUB	#DSLSTB,R1	;- σδχιη χχεςθ
	NEG	(SP)
2$:	BIC	#140000,R1
	ADD	ANVP,R1
	INCB	PRNRUL
	JSR	PC,(R4)

	MOV	#KTVSS,R4	;  σδχιη όλςαξα
	MOV	(SP)+,R1
	BPL	3$
	NEGB	R4		;- σδχιη χξιϊ
3$:	ADD	BAZVP,R1
	BIC	#140000,R1
	MOV	R1,BAZVP
	;ADD	R4,@#ARRUL
	DECB	PRNRUL
	BR	KRUL

1$:	MOV	#36,R2		;  ςεφιν ςασϋις. πανρτι
	MOV	#73200,R1	;- σδχιη όλςαξα χχεςθ
	NEG	R3
	BEQ	4$
	MOV	#75600,R1	;- σδχιη όλςαξα χξιϊ
4$:	MOV	KRUL2(R3),R4
	JSR	PC,(R4)

KRUL:	RTS	PC
KRUL1:	.WORD	PSDWN
KRUL2:	.WORD	PSDWW


;    -------------------------------
;    ** 2.2. ζοςνιςοχαξιε σινχομα **
;    -------------------------------

PFSIM:	ASL	R0		;  χωώισμεξιε αδς. ιϊοβς.
	MOV	R0,R1
	ASL	R0
	ASL	R0
	ADD	R0,R1
	ADD	#IZSIM,R1

	MOV	AS,R3		;  ποδη. αδς. ι σώετώιλα
	MOV	#11,R2

	TSTB	PRCW		;  ώβ/γχ
	BNE	PFCWS

;	ζοςνιςοχαξιε ώεςξο-βεμοηο σινχομα
;	---------------------------------

	CLR	R0		;  υστ. πςιϊξ. ιξχεςσιι
	TSTB	PRINWS
	BEQ	1$
	COM	R0
1$:	TST	FON
	BEQ	2$
	COM	R0

2$:	MOVB	(R1)+,(R3)	;  ζοςνιςοχαξιε σινχομα
	TST	R0
	BEQ	3$
	COMB	(R3)
3$:	JSR	PC,PFTAN
	SOB	R2,2$
	MOVB	(R1)+,(R3)
	TST	R0
	BEQ	4$
	COMB	(R3)

4$:	TSTB	PRPODC		;  ποδώεςλιχαξιε
	BEQ	KFSIM
	MOVB	MASCW,(R3)
	BR	KFSIM

;	ζοςνιςοχαξιε γχετξοηο σινχομα
;	-----------------------------

PFCWS:	CLR	-(SP)

6$:	MOVB	(R1)+,R5	;  ποδη. ισθ. δαξξ. στςολι
	BIC	#177400,R5
	MOV	#20,R4
	CLR	R0

	TSTB	PRINWS		;  ιξχεςσιρ
	BEQ	1$
	COMB	R5

1$:	TSTB	R5		;  ςασϋιςεξιε στςολι
	BEQ	2$
5$:	ASR	R5
	BCC	3$
	BEQ	4$
	BIS	MASPOZ(R4),R0
3$:	SUB	#2,R4
	BNE	5$
4$:	BIS	MASPOZ(R4),R0

2$:	MOV	FON,R5		;  ζοςνιςοχαξιε γχετα
	BIC	R0,R5
	MOV	MASCW,R4
	COM	R0
	BIC	R0,R4
	BIS	R5,R4

	MOV	R4,(R3)		;  ϊαπισψ στςολι σινχομα

	JSR	PC,PFTAN	;  λοξεγ γιλμα
	SOB	R2,6$

	TST	(SP)		;  χωθοδ
	BNE	7$
	INC	(SP)
	INC	R2

	TSTB	PRPODC		;  ποδώεςλιχαξιε
	BEQ	6$
	MOV	MASCW,(R3)

7$:	MOV	(SP)+,R0

KFSIM:	RTS	PC


;    -------------------------------------------
;    ** 2.3. ζοςνιςοχαξιε σινχομψξοηο λυςσοςα **
;    -------------------------------------------

PFSK:				;  ζοςνιςοχαξιε ι στιςαξιε σινχ. λυςσ.
PSTSK:	TSTB	PRGAHK		;  πςιϊξαλ ηαϋ. λυςσ.
	BNE	KFSK

	MOV	AS,R3		;  ποδη. παςαν.
	MOV	#KTVSS,R2

	TSTB	PRCW		;  ώβ/γχ
	BNE	1$

	MOV	#377,R5		;  ώεςξο-βεμωκ
	ASR	R3
	BCC	2$
	SWAB	R5
2$:	ASL	R3
	BR	3$

1$:	MOV	MASCW,R5	;  γχετξοκ
	MOV	FON,R4
	XOR	R4,R5

3$:	XOR	R5,(R3)		;  ιϊνεξεξιε ναςλεςα
	JSR	PC,PFTAN
	SOB	R2,3$

KFSK:	RTS	PC


;   ======================================
;   *** 3. βμολ ςεδαλτιςυΰύιθ σινχομοχ ***
;   ======================================


BRS:	TSTB	PRBLR		;  ςεφιν βμολ.ςεδ.
	BEQ	1$
	JSR	PC,PFUS1
	BR	KBRS

1$:	MOV	NOMSIM,R1	;  ποδη.παςαν.
	MOV	DSIMB,R2
	MOV	#KSSTR,R3

	CMPB	R0,#10		;  λμ
	BNE	2$
	SUB	R2,R1
	BR	3$

2$:	SUB	#22,R0		;  χωβος λοδα
	ASL	R0
	MOV	4$(R0),R5
	JSR	PC,(R5)
	RTS	PC
4$:	.WORD	22$
	.WORD	PSTRW
	.WORD	PSTRN
	.WORD	25$
	.WORD	PSIML
	.WORD	PSIMP
	.WORD	PANSIM
	.WORD	31$
	.WORD	32$
	.WORD	33$
	.WORD	34$
	.WORD	35$
	.WORD	36$
	.WORD	37$

22$:	CLR	R1		;  λξό
	BR	3$

25$:	ADD	R3,R1		;  λξσσ
	BIC	#77,R1
	BR	3$

31$:	ADD	R2,R1		;  λπ
	BR	3$

32$:	SUB	R3,R1		;  λχ
	BR	3$

33$:	ADD	R3,R1		;  λξ
	BR	3$

34$:	SUB	R3,R1		;  λμχ
	SUB	R2,R1
	BR	3$

35$:	SUB	R3,R1		;  λπχ
	ADD	R2,R1
	BR	3$

36$:	ADD	R3,R1		;  λπξ
	ADD	R2,R1
	BR	3$

37$:	ADD	R3,R1		;  λμξ
	SUB	R2,R1

3$:	MOV	R1,NOMSIM	;  ςεδαλτιςοχαξιε λυςσοςα
	JSR	PC,PREDSK

KBRS:	RTS	PC


;    -------------------------------
;    ** 3.1. αξυμιςοχαξιε σινχομα **
;    -------------------------------

PANSIM:	JSR	PC,PSTSK
	SUB	DSIMB,NOMSIM
	CLR	R5
	JSR	PC,PFASIM
	JSR	PC,PSBRS
	JSR	PC,PFSK

	RTS	PC


;    ----------------------------------
;    ** 3.2. σνεύεξιε σινχομοχ χμεχο **
;    ----------------------------------

PSIML:	MOV	AS,R3		;  ποδηοτοχλα αδςεσοχ
	MOV	R3,R4
	BIS	#76,R4
	BIS	DSIMB,R4
	MOV	#12,R2

3$:	MOV	R3,R1		;  ποδηοτοχλα γιλμα
	MOV	R1,R5
	ADD	DSIMB,R5

2$:	BIT	#77,R5		;  σδχιη στςολι
	BEQ	1$
	MOVB	(R5)+,(R1)+
	BR	2$

1$:	JSR	PC,PFTAN	;  ιϊνεξεξιε αδς.στςολι
	SOB	R2,3$

	MOV	AS,-(SP)	;  σβςοσ ποσμεδξεηο σινχ.
	MOV	R4,AS
	JSR	PC,PSBRS
	MOV	(SP)+,AS

	JSR	PC,PFSK

	RTS	PC


;    -----------------------------------
;    ** 3.4. σνεύεξιε σινχομοχ χπςαχο **
;    -----------------------------------

PSIMP:	JSR	PC,PSTSK

	MOV	AS,R3		;  ποδη.αδςεσοχ
	MOV	#12,R2

2$:	MOV	R3,R5		;  ποδη.γιλμα
	BIS	#77,R5
	INC	R5
	MOV	R5,R1
	SUB	DSIMB,R1

1$:	MOVB	-(R1),-(R5)	;  σδχιη στςολι
	CMP	R5,R3
	BNE	1$

	JSR	PC,PFTAN	;  ιϊνεξεξιε αδς. στςολι
	SOB	R2,2$

	JSR	PC,PSBRS	;  σβςοσ τελυύεηο σινχ.

	JSR	PC,PFSK		;  ζοςνιςοχαξιε λυςσοςα

	RTS	PC


;    -------------------------------
;    ** 3.4. σνεύεξιε στςολ χχεςθ **
;    -------------------------------

PSTRW:	MOV	AS,R1		;  αδςεσ ιστοώξιλα
	BIC	#77,R1
	ADD	#DSSTRB,R1
	BPL	1$
	SUB	DVPB,R1

1$:	JSR	PC,PSCTVS	;  οπςεδ.σώ.τχ.στςολ

	JSR	PC,PSDWW	;  σδχιη χχεςθ
	JSR	PC,PFSK

	RTS	PC


;    ------------------------------
;    ** 3.5. σνεύεξιε στςολ χξιϊ **
;    ------------------------------

PSTRN:	JSR	PC,PSTSK

	MOV	BAZVP,R1	;  αδςεσ ιστοώξιλα + 1
	ADD	DGPB,R1
	SUB	#DSSTRB,R1
	BIC	#140000,R1
	ADD	ANVP,R1

	JSR	PC,PSCTVS	;  οπςεδ. σώ. τχ. στςολ

	JSR	PC,PSDWN	;  σδχιη χξιϊ
	JSR	PC,PFSK

	RTS	PC


;    ---------------------------------------
;    ** 3.6. χωώισμεξιε σώετώιλα TV στςολ **
;    ---------------------------------------

PSCTVS:	MOV	KSVP,R3		;  δμιξα πομρ
	MOV	NOMSIM,R2
	BIS	#77,R2
	INC	R2
	SUB	R2,R3

	MOV	#5,R2		;  δεμεξιε ξα 32
1$:	ASR	R3
	SOB	R2,1$

	MOV	R3,R2		;  υνξοφεξιε ξα 5
	ASL	R3
	ASL	R3
	ADD	R3,R2

	RTS	PC


;   ====================================
;   *** 4. βμολ υπςαχμρΰύιθ σινχομοχ ***
;   ====================================


BUS:	CMPB	R0,#12		;  πσ
	BNE	1$
	JSR	PC,PFUS
	BIT	#77,NOMSIM
	BNE	3$
	TSTB	PRISU
	BNE	KBUS
3$:	BIS	#77,NOMSIM
	INC	NOMSIM
	JSR	PC,PREDSK
	BR	KBUS

1$:	TSTB	PRBLR
	BNE	PFUS

	CMPB	R0,#14		;  σβς
	BNE	2$
	JSR	PC,PSBR
	BR	KBUS

2$:	CMPB	R0,#7		;  ϊχ
	BNE	PFUS
	JSR	PC,PSIGN
	BR	KBUS


;    --------------------------------------------
;    ** 4.1. ζοςνιςοχαξιε υπςαχμρΰύεηο σινχομα **
;    --------------------------------------------

PFUS:	TSTB	PRISU		;  ςεφιν ιξδ.συ.
	BEQ	KFUS

PFUS1:	SUB	#20,R0		;  ςεδ. σινχομω
	BMI	2$
4$:	JSR	PC,BGS
	BR	KFUS

2$:	CMPB	R0,#-10		;  χϋ
	BNE	3$
	MOV	#1,R0
	BR	4$

3$:	ADD	#100,R0		;  συ
	COMB	PRINWS
	JSR	PC,BGS
	COMB	PRINWS
	BR	KFUS

KFUS:
KBUS:	RTS	PC


;   =======================================
;   *** 5. βμολ ζυξλγιοξαμψξωθ σινχομοχ ***
;   =======================================


BFS:	CMPB	R0,#202		;  ισυ
	BNE	1$
	COMB	PRISU
	MOV	#3,R0
	BR	11$

1$:	CMPB	R0,#204		;  βμς
	BNE	2$
	COMB	PRBLR
	MOV	#4,R0
11$:	BR	BFS1

2$:	CMPB	R0,#214		;  ςπ
	BNE	3$
	JSR	PC,PPRP
	BR	KBFS

3$:	MOVB	PRGRAF,R5
	BNE	BFS0
	TSTB	PRBLR
	BNE	BFS2

BFS0:	SUB	#221,R0		;  χωβος λοδα
	BMI	KBFS
	ASL	R0
	ADD	R0,PC
	BR	21$
	BR	21$
	BR	21$
	BR	21$
	BR	25$
	BR	26$
	BR	27$
	BR	KBFS
	BR	31$
	BR	32$
	BR	33$
	BR	34$
	BR	35$
	BR	36$
	BR	37$

21$:	TSTB	PRCW
	BEQ	KBFS
	MOV	KMASCW(R0),R0	;  λ/ϊ/σ/ώ
	CLRB	PRINWF
	JSR	PC,PSTK
	MOV	R0,MASCW
	JSR	PC,PFK
	BR	KBFS

25$:	JSR	PC,PPGRAF	;  ηςαζ
1$:	MOV	#5,R0
	BR	BFS1

26$:	TST	R5		;  ϊαπ
	BEQ	KBFS
	CLRB	PRSTIR
	COMB	PRZAP
	BR	1$

27$:	TST	R5		;  στις
	BEQ	KBFS
	CLRB	PRZAP
	COMB	PRSTIR
	BR	1$

31$:	TST	R5		;  σβς. λ. στς.
	BNE	KBFS
	JSR	PC,PSBKST
	BR	KBFS

32$:	JSR	PC,PSTK		;  ηαϋ. λυςσ.
	COMB	PRGAHK
	JSR	PC,PFK
	BR	KBFS

33$:	JSR	PC,PPCW		;  γχ
	BR	KBFS

34$:	COMB	PRINWS		;  ιξχ.σ.
	MOV	#2,R0
	BR	BFS1

35$:	JSR	PC,PINWF	;  ιξχ. ό.
	BR	KBFS

36$:	MOV	FON,FONSS	;  υστ.ιξδ.
	MOV	MASCW,MCWSS
	MOV	PRPODC,PRPSSS
	MOVB	PRCW,PRCWSS
	JSR	PC,PSTK
	;JSR	PC,PFSSTR
	JSR	PC,PFK
	BR	KBFS

37$:	COMB	PRPODC		;  ποδώ.
	MOV	#1,R0

BFS1:	;JSR	PC,PFINDR	;  ζοςν. ιξδ. ςεφινα
	BR	KBFS

BFS2:	JSR	PC,PFFS		;  ζοςν. ζυξλγ. σινχ.

KBFS:	RTS	PC


;    ------------------------------------------
;    ** 5.1. πεςελμΰώεξιε ςασϋιςεξξοκ πανρτι **
;    ------------------------------------------

PPRP:	;HALT ;DEBUG
;	COMB	PRRP
;	BNE	PPRP2
;
PPRP1:	MOV	#40000,ANVP	;  ξε ςασϋιςεξξαρ πανρτψ
	MOV	#40000,DVPB
	MOV	#36000,DGPB
	MOV	#3000,KSVP
	;MOV	#NZRUL0,@#ARRUL
	;BR	KPRP

; PPRP2:	MOV	#70000,ANVP	;  ςασϋιςεξξαρ πανρτψ
; 	MOV	#10000,DVPB
; 	MOV	#5000,DGPB
; 	MOV	#400,KSVP
; 	;MOV	#NZRUL1,@#ARRUL
; 	MOV	#77000,R3	;- υστ. ιξδ. ςπ.
; 	MOV	#340,R4
; 1$:	MOV	FONSS,(R3)+
; 	SOB	R4,1$
; 	MOV	MCWSS,R1
; 	JSR	PC,PZTVSN

KPRP:	MOV	#DSLSTB,BAZVP	;  υστ. βαϊω
	JSR	PC,PSBR		;  σβςοσ όλςαξα
	;JSR	PC,PFSSTR	;  ζοςν. σμ. στς.

	RTS	PC


;    -------------------------------------------
;    ** 5.2. πεςελμΰώεξιε ηςαζιώεσλοηο ςεφινα **
;    -------------------------------------------

PPGRAF:	JSR	PC,PSTK
	COMB	PRGRAF
	BEQ	1$

	MOVB	NMPGT,MASPGT	;  υστ. ηςαζ. ςεφινα
	CLR	DGW
	CLR	SCTVS
	MOV	AS,R0
	MOV	R0,AGT
	SUB	ANVP,R0
	SUB	BAZVP,R0
	BPL	2$
	ADD	DVPB,R0
2$:	MOV	R0,AGTVP
	BR	KPGRAF

1$:	CLRB	PRZAP		;  σβςοσ ηςαζ. ςεφινα
	CLRB	PRSTIR
	TSTB	PRCW		;- χωώισμεξιε AS
	BEQ	3$
	BIC	#1,NOMSIM
3$:	CLR	R5
	JSR	PC,PFASIM

KPGRAF:	MOV	#5,R0
	;JSR	PC,PFINDR	;  ζοςν. ιξδ. ςεφινα
	JSR	PC,PFK

	RTS	PC


;    -----------------------------
;    ** 5.3. σβςοσ λοξγα στςολι **
;    -----------------------------

PSBKST:	MOV	AS,-(SP)

1$:	JSR	PC,PSBRS	;  σβςοσ
	ADD	DSIMB,AS
	BIT	#77,AS
	BNE	1$

	MOV	(SP)+,AS	;  ζοςνιςοχαξιε λυςσοςα
	JSR	PC,PFSK

	RTS	PC


;    ---------------------------------------
;    ** 5.4. πεςελμΰώεξιε γχετξοηο ςεφινα **
;    ---------------------------------------

PPCW:	JSR	PC,PSTK

	COMB	PRCW
	BNE	1$

	DEC	DSIMB		;  ώεςξο-βεμωκ
	CLR	R5
	TSTB	PRINWF
	BEQ	2$
	COM	R5
2$:	MOV	R5,FON
	COM	R5
	MOV	R5,MASCW
	MOVB	#1,NMPGT	;- ηςαζ.
	BICB	#252,MASPGT
	BR	3$

1$:	INC	DSIMB		;  γχετξοκ
	TSTB	PRGRAF
	BNE	6$
	INC	NOMSIM
	BIC	#1,NOMSIM
	CLR	R5
	JSR	PC,PFASIM
6$:	MOVB	#3,NMPGT	;- ηςαζ.
	MOVB	MASPGT,R5
	BITB	#252,R5
	BEQ	4$
	ASRB	R5
	BR	5$
4$:	ASLB	R5
5$:	BISB	R5,MASPGT

3$:	JSR	PC,PFINDT
	JSR	PC,PFK

	RTS	PC


;    ------------------------
;    ** 5.5. ιξχεςσιρ ζοξα **
;    ------------------------

PINWF:	COMB	PRINWF

	MOV	MASCW,R0	;  σνεξα νασολ
	MOV	FON,MASCW
	MOV	R0,FON

	MOV	MASCW,R5	;  ποδηοτ. παςαν
	XOR	R5,R0
	MOV	BAZVP,R1
	ADD	ANVP,R1
	MOV	DGPB,R2
	ASR	R2

2$:	XOR	R0,(R1)+	;  ιξχεςσιρ ζοξα
	TST	R1
	BPL	1$
	SUB	DVPB,R1
1$:	SOB	R2,2$

	RTS	PC


;    -----------------------------------------------
;    ** 5.6. ζοςνιςοχαξιε ζυξλγιοξαμψξωθ σινχομοχ **
;    -----------------------------------------------

PFFS:	CMPB	R0,#225		;- η
	BNE	1$
	MOV	#267,R0
	BR	2$
1$:	CMPB	R0,#226		;- ϊ
	BNE	3$
	MOV	#312,R0
	BR	2$
3$:	CMPB	R0,#227		;- C
	BNE	4$
	MOV	#303,R0
	BR	2$

4$:	ADD	#20,R0

2$:	COMB	PRINWS		;  ζοςν. σινχ.
	JSR	PC,PFSIM
	COMB	PRINWS

	ADD	DSIMB,NOMSIM	;  ιϊν. αδςεσα
	JSR	PC,PFASIM
	JSR	PC,PFSK

	RTS	PC


;   =================================
;   *** 6. βμολ τελστοχοκ ηςαζιλι ***
;   =================================


BTG:	CMPB	R0,#37		;  υλαϊατεμι ξαπςαχμεξιρ
	BHI	1$
	JSR	PC,PFNGW
	BR	KBTG1

1$:	BIC	#177400,R0
	CMPB	R0,#71		;  γιζςω
	BHI	2$
	JSR	PC,PFDGW
	BR	KBTG

2$:	CMPB	R0,#237		;  ζυξλγιοξαμψξωε λοδω
	BHI	KBTG1
	JSR	PC,BFS

KBTG1:	CLR	DGW
KBTG:	RTS	PC


;    --------------------------------------
;    ** 6.1. ζοςνιςοχαξιε ξαπςαχμεξιρ GW **
;    --------------------------------------

PFNGW:	JSR	PC,PSTGK

	CLR	R1		;  ποδη. παςαν.
	CLR	R2
	MOV	#DTVSTB,R4

	MOVB	R0,R3		;  χωβος λοδα
	SUB	#31,R3
	BMI	1$
	ASL	R3
	ADD	R3,PC
	BR	31$
	BR	32$
	BR	33$
	BR	34$
	BR	35$
	BR	36$
	BR	37$

31$:	INC	R1		;  λπ
	BR	PFNGW2

32$:	SUB	R4,R2		;  λχ
	BR	PFNGW2

33$:	ADD	R4,R2		;  λξ
	BR	PFNGW2

34$:	SUB	R4,R2		;  λμχ
	DEC	R1
	BR	PFNGW2

35$:	SUB	R4,R2		;  λπχ
	INC	R1
	BR	PFNGW2

36$:	ADD	R4,R2		;  λπξ
	INC	R1
	BR	PFNGW2

37$:	ADD	R4,R2		;  λμξ
	DEC	R1
	BR	PFNGW2

1$:	CMPB	R0,#10		;  λμ
	BNE	2$
	DEC	R1
	BR	PFNGW2

2$:	CMPB	R0,#22		;  λξό
	BNE	3$
	CLR	NOMSIM
	JMP	PSBR1

3$:	CMPB	R0,#14		;  σβςοσ
	BNE	KFNGW
	JSR	PC,PSBR
	RTS	PC

PFNGW2:	MOV	DGW,R4		;  ϊαηςυϊλα DGW
	BNE	PFGW
	CLRB	R0
	SWAB	R0
	INC	R0
	MOV	R0,R4


;    ----------------------------------------------
;    ** 6.1.1. ζοςνιςοχαξιε ηςαζιώεσλοηο χελτοςα **
;    ----------------------------------------------

PFGW:	TSTB	PRZAP		;  ϊαπ
	BEQ	1$
	MOV	MASCW,R0
	BR	2$

1$:	TSTB	PRSTIR		;  στις
	BEQ	3$
	MOV	FON,R0

2$:	MOVB	MASPGT,R5	;  ζοςνις. τοώλι
	BICB	R5,@AGT
	MOV	R0,R3
	COM	R5
	BIC	R5,R3
	BISB	R3,@AGT
	JSR	PC,PFAGT
	SOB	R4,2$
	BR	KFGW

3$:	JSR	PC,PFAGT	;  πεςενεύεξιε
	SOB	R4,3$

KFGW:
KFNGW:	JSR	PC,PFGK
	RTS	PC


;    -------------------------------
;    ** 6.1.1.1. ζοςνιςοχαξιε AGT **
;    -------------------------------

PFAGT:	MOV	AGTVP,R5
	ADD	R2,R5
	ADD	R2,SCTVS
	MOV	MASPGT,-(SP)
	MOV	#100,R3

	TST	R1		;  πςρνο/χμεχο/χπςαχο
	BEQ	1$
	BMI	2$

	ASLB	(SP)		;  σδχιη χπςαχο
	BCC	3$
	ADCB	(SP)
	INC	R5
	INC	NOMSIM
	BIT	#77,R5
	BNE	3$
	SUB	R3,R5
	SUB	R3,NOMSIM
3$:	TSTB	PRCW
	BEQ	1$
	ASLB	(SP)
	ADCB	(SP)
	BR	1$

2$:	CLC
	RORB	(SP)		;  σδχιη χμεχο
	BCC	4$
	BISB	#200,(SP)
	BIT	#77,R5
	BNE	21$
	ADD	R3,R5
	ADD	R3,NOMSIM
21$:	DEC	NOMSIM
	DEC	R5
4$:	TSTB	PRCW
	BEQ	1$
	CLC
	RORB	(SP)
	BCC	1$
	BISB	#200,(SP)

1$:	MOV	(SP)+,MASPGT
	MOV	#DSSTRB,-(SP)
	TST	SCTVS
	BPL	11$
	NEG	R3
	NEG	(SP)
	BR	12$
11$:	CMP	SCTVS,(SP)
	BLO	13$
12$:	SUB	(SP),SCTVS
	ADD	R3,NOMSIM
	BMI	14$
	CMP	NOMSIM,KSVP
	BLO	13$
14$:	SUB	(SP),R5
	MOV	R5,-(SP)	;- ςυμοξ
	JSR	R4,PSREG
	CLR	R5
	JSR	PC,PFASIM
	JSR	R4,PWREG
	MOV	(SP)+,R5
13$:	MOV	(SP)+,R3

PFAGT1:	MOV	R5,AGTVP	;- AGTVP
	ADD	BAZVP,R5	;- AGT
	BIC	#140000,R5
	ADD	ANVP,R5
	MOV	R5,AGT

	RTS	PC


;    ----------------------------------------------
;    ** 6.1.2. ζοςνιςοχαξιε ηςαζιώεσλοηο λυςσοςα **
;    ---------------------------------------------

PFGK:				;  ζοςνιςοχαξιε ι στιςαξιε λυςσοςα
PSTGK:	TSTB	PRGAHK		;  πςοχ. πςιϊξαλα
	BNE	KFGK

	MOV	MASCW,R4	;  ζοςνιςοχαξιε νασλι τοώλι
	MOV	FON,R5
	XOR	R5,R4
	CLR	R5
	BISB	MASPGT,R5
	COM	R5
	BIC	R5,R4

	MOV	AGT,R3		;  ποδη. αδςεσοχ
	ASR	R3
	BCC	1$
	SWAB	R4
1$:	ASL	R3
	MOV	R3,R1
	SUB	#300,R3
	CMP	R3,ANVP
	BHIS	11$
	ADD	DVPB,R3

11$:	MOV	#7,R2		;  ζοςνιςοχαξιε χεςτ. ώεςτω
2$:	XOR	R4,(R3)
	JSR	PC,PFTAN
	SOB	R2,2$

	MOV	#3,R2		;  σδχιη νασλι χμεχο
	CLC
	MOVB	PRCW,R5
	BEQ	3$
	ASL	R2
3$:	ROR	R4		;- σδχιη
	BCC	4$
	DEC	R1
	ROR	R4
4$:	SOB	R2,3$
	BIC	#1,R1
	CMP	R1,ANVP
	BHI	41$
	ADD	DVPB,R1

41$:	MOV	#7,R2		;  ζοςνιςοχαξιε ηοςιϊ.ώεςτω
7$:	XOR	R4,(R1)
	ROL	R4
	BCC	5$
	JSR	PC,PFGK1
5$:	MOV	R5,R5
	BEQ	6$
	ROL	R4
	BCC	6$
	JSR	PC,PFGK1
6$:	SOB	R2,7$
KFGK:	RTS	PC

PFGK1:	ADD	#2,R1		;  πςιςαύεξιε αδςεσα
	BPL	1$
	SUB	DVPB,R1
1$:	SEC
	ROL	R4
	RTS	PC


;    --------------------------------
;    ** 6.2. ζοςνιςοχαξιε δμιξω GW **
;    --------------------------------

PFDGW:	SUB	#60,R0
	BPL	1$
	CLR	R0
	BR	2$

1$:	MOV	DGW,R1		;  υνξοφεξιε ξα 10
	ASL	R1
	ADD	R1,R0
	ASL	R1
	ASL	R1
	ADD	R1,R0
2$:	MOV	R0,DGW

KFDGW:	RTS	PC


; ======================================
; ***** νοδυμψ ζοςνιςοχαξιρ στςολι *****
; ======================================


;	χθοδ:	R1 - αδςεσ στςολι
;		R2 - δμιξα στςολι (νμ.β.)
;		   - σινχομ - οηςαξιώιτεμψ (στ.β.)

MFSTR:	MOV	R0,-(SP)
	MOV	R3,-(SP)

	MOV	R2,R3		;  ποδηοτοχλα οηςαξιώιτεμεκ
	SWAB	R3
	BIC	#177400,R2

1$:	MOVB	(R1)+,R0	;  ϊαπισψ στςολι
	JSR	PC,MFSIM
	CMPB	R0,R3
	BEQ	KMFSTR
	SOB	R2,1$

KMFSTR:	MOV	(SP)+,R3
	MOV	(SP)+,R0
	RTS	PC


; ======================================
; ***** νοδυμψ ϊαπισι σινχομα χ σσ *****
; ======================================


;	χθοδ:	R0 - λοδ σινχομα (0 - σβςοσ στςολι)
;		R1 - ξονες ποϊιγιι χ σσ

MZSSS:	JSR	R4,PSREG

	TST	R0
	BNE	1$

	;JSR	PC,PFSSTR	;  σβςοσ σσ
	BR	KMZSSS

1$:	CMPB	R0,#177		;  ποδηοτ. αδς. ιϊοβςαφ.
	BHI	3$
	CMPB	R0,#10
	BNE	4$
	MOV	#21,R0
4$:	SUB	#20,R0
	BMI	KMZSSS
	BR	5$
3$:	CMPB	R0,#237
	BLOS	KMZSSS
	SUB	#60,R0

5$:	JSR	PC,PFSSS	;  ζοςνιςοχαξιε σινχομα

KMZSSS:	JSR	R4,PWREG
	RTS	PC


;    ----------------------------------
;    ** 1. ζοςνιςοχαξιε σινχομα χ σσ **
;    ----------------------------------

PFSSS:	MOV	R1,-(SP)	;  R0 - σνεύεξιε ιϊοβςαφεξιρ
	MOV	R2,-(SP)	;  R1 - ξονες ποϊιγιι χ στςολε

	TSTB	PRCW		;  ποδη. αδς.
	BEQ	1$
	ASL	R1
1$:	BIC	#177700,R1
	ADD	BAZVP,R1
	SUB	#1700,R1
	BIC	#140000,R1
	ADD	ANVP,R1

	MOV	AS,-(SP)	;  ζοςνιςοχαξιε σινχομα
	MOV	R1,AS
	BIC	#177400,R0
	JSR	PC,PFSIM
	MOV	(SP)+,AS

KFSSS:	MOV	(SP)+,R2
	MOV	(SP)+,R1
	RTS	PC


; ==============================================
; ***** νοδυμψ υσταξοχλι λοοςδιξατ λυςσοςα *****
; ==============================================

;	χθοδ:	R1 - λοοςδιξατα X
;		R2 - λοοςδιξατα Y

MUSTKK:	JSR	R4,PSREG
	JSR	PC,PSTK
	MOV	2(SP),R1
	MOV	4(SP),R2

	TSTB	PRCW		;  ποδη. λοοςδ. X
	BEQ	1$
	ASL	R1

1$:	MOV	#6,R0		;  ποδη. λοοςδ. Y
2$:	ASL	R2
	SOB	R0,2$

	TSTB	PRGRAF
	BNE	PUKGK


;    ------------------------------------------------
;    ** 1. υσταξοχλα λοοςδιξατ σινχομψξοηο λυςσοςα **
;    ------------------------------------------------

PUKSK:	BIC	#177700,R1	;  ποδη. λοοςδ. X

1$:	SUB	KSVP,R2		;  ποδη. λοοςδ. Y
	BPL	1$
2$:	ADD	KSVP,R2
	BMI	2$

	ADD	R1,R2		;  ζοςν. αδς. σινχομα
	MOV	R2,NOMSIM
	CLR	R5
	JSR	PC,PFASIM

	BR	KUSTKK


;    -------------------------------------------------
;    ** 2. υσταξοχλα λοοςδιξατ ηςαζιώεσλοηο λυςσοςα **
;    -------------------------------------------------

PUKGK:	BIC	#177000,R1	;  ποδη. λοοςδ. X
1$:	MOV	R1,R3
	ASR	R1
	ASR	R1
	ASR	R1

	MOVB	NMPGT,R0	;  ποδη. MASPGT
	BIC	#177770,R3
	BEQ	2$
3$:	ASL	R0
	SOB	R3,3$
2$:	MOVB	R0,MASPGT

4$:	SUB	DGPB,R2		;  ποδη. λοοςδ. Y
	BPL	4$
5$:	ADD	DGPB,R2
	BMI	5$

	ADD	R1,R2		;  χωώισμεξιε AGTVP
	MOV	R2,AGTVP

	CLR	R1		;  χωώ. AGT
	CLR	R2
	JSR	PC,PFAGT

KUSTKK:	JSR	PC,PFK
	JSR	R4,PWREG
	RTS	PC


; ==========================================
; ***** νοδυμψ σ'ενα λοοςδιξατ λυςσοςα *****
; ==========================================

;	χωθοδ:	R1 - λοοςδιξατα X
;		R2 - λοοςδιξατα Y

MSKK:	MOV	R0,-(SP)

	TSTB	PRGRAF
	BNE	PSKGK


;    -------------------------------------------
;    ** 1. σ'εν λοοςδιξατ σινχομψξοηο λυςσοςα **
;    -------------------------------------------

PSKSK:	MOV	NOMSIM,R1	;  λοοςδ. X
	MOV	R1,R2
	BIC	#177700,R1

	BR	PSK1


;    --------------------------------------------
;    ** 2. σ'εν λοοςδιξατ ηςαζιώεσλοηο λυςσοςα **
;    --------------------------------------------

PSKGK:	MOV	AGTVP,R1	;  λοοςδ. X
	MOV	R1,R2
	BIC	#177700,R1
	ASL	R1
	ASL	R1
	ASL	R1
	MOVB	MASPGT,R0
2$:	ASR	R0
	BCS	PSK1
	INC	R1
	BR	2$

PSK1:	TSTB	PRCW
	BEQ	3$
	ASR	R1

3$:	BIC	#77,R2		;  λοοςδ. Y
	MOV	#6,R0
4$:	ASR	R2
	SOB	R0,4$

	MOV	(SP)+,R0
	RTS	PC


; =====================================
; ***** νοδυμψ ζοςνιςοχαξιρ τοώλι *****
; =====================================

;	χθοδ:	R0 - 1-ϊαπισψ, 0-στιςαξιε
;		R1 - λοοςδιξατα X
;		R2 - λοοςδιξατα Y

MFTCK:	MOV	R1,BUFX		;  σοθς. λοοςδ.
	MOV	R2,BUFY
	MOVB	R0,PRZTCK

MFTCK1:	JSR	R4,PSREG	;  σοθς. ςεη.

	TSTB	PRCW		;  ποδη. λοοςδ. X
	BEQ	1$
	ASL	R1
	BCS	KMFTCK
1$:	CMP	R1,#1000
	BHIS	KMFTCK

	MOV	#6,R0		;  ποδη. λοοςδ. Y
2$:	ASL	R2
	BCS	KMFTCK
	SOB	R0,2$
	CMP	R2,DGPB
	BHIS	KMFTCK

	MOV	R1,R3		;  ζοςν. αδς. τοώλι
	ASR	R1
	ASR	R1
	ASR	R1
	ADD	R2,R1
	ADD	BAZVP,R1
	BIC	#140000,R1
	ADD	ANVP,R1

	MOVB	NMPGT,R2	;  ζοςνιςοχαξιε νασλι τοώλι
	BIC	#177770,R3
	BEQ	3$
4$:	ASL	R2
	SOB	R3,4$

3$:	MOVB	(R1),R0		;  ζοςνιςοχαξιε τοώλι
	BICB	R2,R0
	MOV	MASCW,R3
	TSTB	PRZTCK
	BNE	5$
	MOV	FON,R3
5$:	COM	R2
	BIC	R2,R3
	BISB	R3,R0
	MOVB	R0,(R1)

KMFTCK:	JSR	R4,PWREG	;  χοσστ. ςεη.
	RTS	PC


; =======================================
; ***** νοδυμψ ζοςνιςοχαξιρ χελτοςα *****
; =======================================


;	χθοδ:	R0 - 1-ϊαπισψ, 0-στιςαξιε
;		R1 - λοοςδιξατα X
;		R2 - λοοςδιξατα Y

MFWEKT:	JSR	R4,PSREG
	MOVB	R0,PRZTCK

	MOV	R1,R3		;  ϊανεξα λοοςδιξατ
	MOV	R2,R4
	MOV	BUFX,R1
	MOV	BUFY,R2
	MOV	R3,BUFX
	MOV	R4,BUFY

	CLR	R0		;  οπςεδ. DX ι ξαπςαχμεξιρ
	SUB	R1,R3
	BMI	1$
	BEQ	2$
	INC	R0
	BR	2$
1$:	DEC	R0		;- ξαπςαχμεξιε
	NEG	R3		;- DX

2$:	CLR	R5		;  οπςεδ. DY ι ξαπςαχμεξιρ
	SUB	R2,R4
	BMI	3$
	BEQ	4$
	INC	R5
	BR	4$
3$:	DEC	R5		;- ξαπςαχμεξιε
	NEG	R4		;- DY

4$:	CMP	R4,R3		;  οπςεδ. δμιξξοκ λοοςδ.
	BHI	5$
	MOV	R5,-(SP)	;- DX >= DY
	CLR	-(SP)
	MOV	R3,R5
	MOV	R4,R3
	MOV	R5,R4		;- R4 - δμιξξαρ λοοςδ.
	CLR	R5
	BR	6$
5$:	CLR	-(SP)		;- DX < DY
	MOV	R0,-(SP)
	CLR	R0		;- R0,R5 - Dσεην. (SP) - Dλοοςδ.

6$:	CLR	-(SP)		;  οπςεδ. παςαν. χελτοςα
	TST	R3
	BNE	7$
	INC	R3		;- οσεχοκ χελτος
	SUB	#12,SP
	BR	8$
7$:	SUB	R3,R4		;- χωώισμεξιε δμιξω σεην.
	BMI	9$
	INC	(SP)		;- δμιξα σεηνεξτα
	BR	7$
9$:	ADD	R3,R4		;- R3 - σώ. σεην. R4 - οστατολ
	MOV	R3,-(SP)	;- λομιώ. σεην.
	MOV	R3,-(SP)
	ASR	(SP)		;- λομιώ. σεην./2
	MOV	R4,-(SP)	;- οστατολ
	CLR	-(SP)
	CLR	-(SP)
	CLR	R4

11$:	ADD	4(SP),2(SP)	;  οπςεδ. δμιξω σεην.
	BEQ	10$
	CMP	2(SP),6(SP)
	BLE	10$
	INC	R4
	SUB	10(SP),2(SP)
