	CMP	R1,ANVP
	BHI	3$
	ADD	DVPB,R1
	BR	4$
3$:	CMP	R3,ANVP
	BHI	4$
	ADD	DVPB,R3
4$:	SOB	R2,5$

PSBRSW:	MOV	#KTVSS,R4	;  σβςοσ στςολι χχεςθ
	MOV	FON,R1
1$:	JSR	PC,PZTVSW
	SOB	R4,1$

