	ASR	R4
	SUB	R4,(SP)		;- δμιξα 2-ηο πομυσεην.

	JSR	PC,PFSEGM	;- ζοςν. 1-ηο πομυσεην.
	ADD	14(SP),R1
	ADD	16(SP),R2
	MOV	(SP),R4
