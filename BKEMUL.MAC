	MOV	#SYSPR,R1

1$:	SEC			;  υσταξοχλα ζμαφλοχ
2$:	ROR	R0
	BCS	KCTSSD
	TSTB	(R1)+
	BNE	1$
	BR	2$

KCTSSD:	MOV	(SP)+,R1
	RTS	PC


