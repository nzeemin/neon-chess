PFK:				;  ζοςνις. ι στις. λυςσοςα
PSTK:	TSTB	PRGRAF
	BNE	1$
	JSR	PC,PFSK		;  σινχ. λυςσος
	MOV	#KPOWTS,BKPOWT
	BR	KFK
