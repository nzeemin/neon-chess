	RTS	PC


;    ---------------------------------------------
;    ** 0.10. ζοςνιςοχαξιε τελυύεηο αδςεσα χξιϊ **
;    ---------------------------------------------

PFTAN:	ADD	#DTVSTB,R3
	BPL	KFTAN
	SUB	DVPB,R3

KFTAN:	RTS	PC


;    --------------------------------------
;    ** 0.11. ϊαπομξεξιε TV-στςολι χχεςθ **
;    --------------------------------------

PZTVSW:	MOV	#DTVSTS,R2	;  R1 - ζοξ, R3 - αδςεσ
	CMP	R3,ANVP
	BHI	1$
	ADD	DVPB,R3
1$:	MOV	R1,-(R3)
	SOB	R2,1$

	RTS	PC


;    -------------------------------------
;    ** 0.12. ϊαπομξεξιε TV-στςολι χξιϊ **
;    -------------------------------------

PZTVSN:	MOV	#DTVSTS,R2	;  R1 - ζοξ, R3 - αδςεσ
	TST	R3
	BPL	1$
	SUB	DVPB,R3
1$:	MOV	R1,(R3)+
	SOB	R2,1$

	RTS	PC


;    -----------------------
;    ** 0.13. σδχιη χχεςθ **
;    -----------------------

PSDWW:	MOV	R1,R3		;  ποδηοτοχλα αδςεσοχ
	SUB	#DSSTRB,R3
	CMP	R3,ANVP
	BHIS	1$
	ADD	DVPB,R3

1$:	TST	R2		;  ποσμεδξρρ στςολα
	BEQ	PSBRSN

5$:	MOV	#DTVSTS,R4	;  σδχιη
2$:	MOV	(R1)+,(R3)+
	SOB	R4,2$
	TST	R1
	BPL	3$
	SUB	DVPB,R1
	BR	4$
3$:	TST	R3
	BPL	4$
	SUB	DVPB,R3
4$:	SOB	R2,5$

PSBRSN:	MOV	#KTVSS,R4	;  σβςοσ στςολι χξιϊ
	MOV	FON,R1
1$:	JSR	PC,PZTVSN
	SOB	R4,1$

	RTS	PC


;    ----------------------
;    ** 0.14. σδχιη χξιϊ **
;    ----------------------

PSDWN:	MOV	R1,R3		;  ποδη. αδςεσοχ
