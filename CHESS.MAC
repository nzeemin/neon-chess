	.ASCII	/    ИНСТРУКЦИЯ /<233>/ПО ЭКСПЛУАТАЦИИ ПРОГРАММЫ/<233><012>
	.ASCII	/         CHESS-V001A/<012>
	.ASCII	<012>
	.ASCII	<233>/1. МАШИНА ЗАПРАШИВАЕТ ВВОДА ДИРЕКТИВ СИМВОЛАМИ /<233>/W./<233>/ ИЛИ /
	.ASCII	<233>/B./<012>
	.ASCII	<233>/2. ПЕРЕД НАЧАЛОМ ИГРЫ ЗАДАЙТЕ УРОВЕНЬ ИГРЫ ДИРЕКТИВОЙ/<012>
	.ASCII	<233>/D=</<233>/УРОВЕНЬ/<233>/>/<233>
	.ASCII	/ (1-САМЫЙ НИЗКИЙ, 5-САМЫЙ ВЫСОКИЙ), НАПРИМЕР:/<012>
	.ASCII	<233>/D=3/<233>/. УРОВЕНЬ ОТОБРАЖАЕТСЯ ПАРАМЕТРОМ "DEPTH=" В ТАБЛИЦЕ/<012>
	.ASCII	/СОСТОЯНИЯ В ВЕРХНЕЙ ЧАСТИ ЭКРАНА./<012>
	.ASCII	/3. ЗАДАЙТЕ ЦВЕТ ФИГУР, ПРИНАДЛЕЖАЩИХ МАШИНЕ:/<012>
	.ASCII	<233>/PW/<233>/ - МАШИНА ИГРАЕТ БЕЛЫМИ; /
	.ASCII	<233>/РВ/<233>/ - МАШИНА ИГРАЕТ ЧЕРНЫМИ./<012>
	.ASCII	/4. ФИГУРЫ ОБОЗНАЧАЮТСЯ СЛЕДУЮЩИМИ СИМВОЛАМИ:/<012>
	.ASCII	<233>/  Р/<233>/ - ПЕШКА/<233>/  R/<233>/ - ЛАДЬЯ/<233>/  N/<233>/ - КОНЬ/<233><012>
	.ASCII	/  В/<233>/ - СЛОН/<233>/  Q/<233>/ - ФЕРЗЬ/<233>/  К/<233>/ - КОРОЛЬ/<012>
	.ASCII	/5. ХОД БЕЗ ВЗЯТИЯ ФИГУРЫ МОЖЕТ БЫТЬ ЗАДАН ОДНИМ ИЗ СЛЕДУЮЩИХ/<012>
	.ASCII	/СПОСОБОВ:/<012>
	.ASCII	/а)<ФИГУРА>-<ПОЗИЦИЯ> /<233>/(НАПР.: Р-Е4)/<233><012>
	.ASCII	/б)<ФИГУРА>/<057>/<ПОЗИЦИЯ>-<ПОЗИЦИЯ>/<233>/ (Р/<057>/Е2-Е4)/<233><012>
	.ASCII	/6. ХОД СО ВЗЯТИЕМ ФИГУРЫ МОЖЕТ БЫТЬ ЗАДАН ОДНИМ ИЗ СЛЕДУЮЩИХ/<012>
	.ASCII	/СПОСОБОВ:/<012>
	.ASCII	/а)<ФИГ.>:<ФИГ.>/<233>/    (Р:Р)/<012>
	.ASCII	<233>/б)<ФИГ.>/<057>/<ПОЗ.>:<ФИГ.>/<233>/ (Р/<057>/Е4:Р)/<012>
	.ASCII	<233>/в)<ФИГ.>:<ФИГ.>/<057>/<ПОЗ.>/<233>/ (Р:Р/<057>/D5)/<233><012>
	.ASCII	/г)<ФИГ.>/<057>/<ПОЗ.>:<ФИГ.>/<057>/<ПОЗ.>/
