; **************************************************
; ***** ТАБЛИЦА КОМАНД ПОЛЬЗОВАТЕЛЯ *****
; **************************************************
;
; Каждая команда - 2 символа.
; Таблица завершается словом 0.
; Адрес обработчика команды лежит в параллельной таблице
; адресов, расположенной через фиксированное смещение
; 000030(24) от текущей позиции сканирования - см. код
; разбора команды: L01156-L01176.
;
L13224:	.BYTE	'P,'W		; command "PW"
L13226:	.BYTE	'P,'B		; command "PB"
L13230:	.BYTE	'P,'N		; command "PN"
L13232:	.BYTE	'I,'N		; command "IN"
L13234:	.BYTE	'R,'E		; command "RE"
L13236:	.BYTE	'S,'K		; command "SK"
L13240:	.BYTE	'W,'=		; command "W="
L13242:	.BYTE	'D,'=		; command "D="
L13244:	.BYTE	'O,'T		; command "OT"
L13246:	.BYTE	'A,'P		; command "AP"
L13250:	.BYTE	'E,'X		; command "EX" (was "T=")
L13252:	.BYTE	'C,'L		; command "CL"
L13254:	.WORD	000000		; terminator

; **************************************************
; ***** ТАБЛИЦА АДРЕСОВ ОБРАБОТЧИКОВ КОМАНД *****
; **************************************************
;
; Параллельна таблице команд (L13224), тот же порядок,
; по одному адресу-обработчику на команду.
;
